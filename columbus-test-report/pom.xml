<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.phonepe.columbus</groupId>
        <artifactId>columbus-bom</artifactId>
        <version>2.1.3-SNAPSHOT</version>
        <relativePath>../columbus-bom</relativePath>
    </parent>

    <artifactId>columbus-test-report</artifactId>
    <packaging>pom</packaging>

    <name>Columbus Test Report</name>
    <description>A module to aggregate test reports across all Columbus modules.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-models</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-core-test-suite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-dropwizard</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-bundle</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v7</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v9</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v7-test-suite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v9-test-suite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-search-algorithms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-core-tests</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v7-tests</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.phonepe.columbus</groupId>
            <artifactId>columbus-elasticsearch-v9-tests</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
